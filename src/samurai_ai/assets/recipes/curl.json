{
  "id": "http.fetch",
  "version": 1,
  "title": "curl fetcher (native)",
  "description": "Native curl for a single in-scope URL; headers and body on stdout.",
  "image": "curlimages/curl@sha256:1c8f1c2b8dc0f6f2b7d8d3d1c8c4a4e9c5b6b2e5d0b1a3c7f9e2d4b6a8c0e2f4",
  "executable": "curl",
  "risk_class": "r2",
  "network": "direct",
  "read_only": true,
  "capabilities": [
    "http"
  ],
  "execution": {
    "native": true,
    "container": false,
    "native_preferred": false
  },
  "provision": {
    "packages": {
      "linux": {
        "manager": "apt",
        "package": "curl",
        "sudo": true
      },
      "macos": {
        "manager": "brew",
        "package": "curl",
        "sudo": false
      }
    },
    "healthcheck": [
      "-V"
    ],
    "limitations": [
      "scope is checked by the adapter only: a native curl bypasses the egress proxy"
    ]
  },
  "params": {
    "url": {
      "type": "string",
      "description": "In-scope http(s) URL",
      "required": true,
      "max_length": 400
    }
  },
  "targets": {
    "param": "url",
    "kind": "url-host",
    "max": 1
  },
  "argv": [
    "-sS",
    "--max-time",
    "30",
    "-D",
    "-",
    "{url}"
  ],
  "parser": "text-lines",
  "limits": {
    "timeout_seconds": 45,
    "memory_mb": 128
  }
}
