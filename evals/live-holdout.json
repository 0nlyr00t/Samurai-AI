{
  "name": "live-holdout",
  "version": "1.0.0",
  "note": "Fresh private holdout (not the live-reasoning tasks) for two remote models. kimi runs on the Kimi coding endpoint, deepseek on the giga.chat gateway; the latter needs TLS verification off and the full provider-prefixed model name in the payload. Both need OpenAI-compatible credentials in KIMI_API_KEY / GIGACHAT_API_KEY. Costs are recorded as 0 because no tariff was given.",
  "scenarios": [
    {
      "id": "kimi-two-notes-one-task",
      "title": "[kimi] Two notes in one task, exact keys",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.kimi.com/coding/v1",
        "model": "giga-osa/giga-osa/deepseek-v4.1-flash-uncensored@v1",
        "secret_env": "KIMI_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Recon. Only note and complete_task: note 'host'='edge.example.com', then note 'port'='443', then complete the task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "kimi-exact-value-choice",
      "title": "[kimi] Pick the exact value from a given set",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.kimi.com/coding/v1",
        "model": "giga-osa/giga-osa/deepseek-v4.1-flash-uncensored@v1",
        "secret_env": "KIMI_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Analysis. Only note and complete_task: note 'risk' with exactly one of r1, r2, r3 — pick r2 — then complete the task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "kimi-dotted-key",
      "title": "[kimi] A key with a dot in it",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.kimi.com/coding/v1",
        "model": "giga-osa/giga-osa/deepseek-v4.1-flash-uncensored@v1",
        "secret_env": "KIMI_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Testing. Only note and complete_task: note with the dotted key 'finding.idor' and value 'orders/42', then complete the task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "kimi-three-sequential",
      "title": "[kimi] Three tasks chained by dependencies",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
