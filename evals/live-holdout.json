        "secret_env": "KIMI_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "recon",
          "title": "Recon. Note 'surface'='login page', then complete the task. Only note and complete_task.",
          "risk_class": "r1"
        },
        {
          "id": "testing",
          "title": "Testing. Note 'hypothesis'='weak password policy', then complete the task. Only note and complete_task.",
          "risk_class": "r1"
        },
        {
          "id": "reporting",
          "title": "Reporting. Note 'summary'='brute force is viable', then complete the task. Only note and complete_task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 3,
        "max_invalid_actions": 4,
        "max_wall_seconds": 600
      }
    },
    {
      "id": "kimi-missing-tool-recovery",
      "title": "[kimi] Ask for an unregistered tool, then recover",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.kimi.com/coding/v1",
        "model": "giga-osa/giga-osa/deepseek-v4.1-flash-uncensored@v1",
        "secret_env": "KIMI_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Probe. Call the unregistered tool 'dnsx_lookup' once, then no tools: note 'retry'='resolve manually instead', then complete.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
