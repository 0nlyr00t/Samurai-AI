{
  "name": "live-holdout",
  "version": "1.0.0",
  "note": "Fresh private holdout (not the live-reasoning tasks) for two remote models: kimi-k3 over the Moonshot API and deepseek-flash-4.1 over the giga.chat gateway, which needs TLS verification off. Both need OPENAI-compatible credentials in MOONSHOT_API_KEY / GIGACHAT_API_KEY; costs are recorded as 0 because no tariff was given.",
  "scenarios": [
    {
      "id": "kimi-two-notes-one-task",
      "title": "[kimi] Two notes in one task, exact keys",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.moonshot.ai/v1",
        "model": "moonshot/kimi-k3@v1",
        "secret_env": "MOONSHOT_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Recon. Use only the note and complete_task commands. Write the note with key 'host' and value 'edge.example.com', then a second note with key 'port' and value '443', then complete the task. No other tools.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "kimi-exact-value-choice",
      "title": "[kimi] Pick the exact value from a given set",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.moonshot.ai/v1",
        "model": "moonshot/kimi-k3@v1",
        "secret_env": "MOONSHOT_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Analysis. Use only the note and complete_task commands. Write the note with key 'risk' and exactly one value out of r1, r2, r3 — pick r2 — then complete the task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "kimi-dotted-key",
      "title": "[kimi] A key with a dot in it",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.moonshot.ai/v1",
        "model": "moonshot/kimi-k3@v1",
        "secret_env": "MOONSHOT_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Testing. Use only the note and complete_task commands. Write the note with the dotted key 'finding.idor' and value 'orders/42', then complete the task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
    {
      "id": "kimi-three-sequential",
      "title": "[kimi] Three tasks chained by dependencies",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.moonshot.ai/v1",
        "model": "moonshot/kimi-k3@v1",
        "secret_env": "MOONSHOT_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "recon",
          "title": "Recon. Note key 'surface' with value 'login page', then complete the task. Only note and complete_task.",
          "risk_class": "r1"
        },
        {
          "id": "testing",
          "title": "Testing. Note key 'hypothesis' with value 'weak password policy', then complete the task. Only note and complete_task.",
          "risk_class": "r1"
        },
        {
          "id": "reporting",
          "title": "Reporting. Note key 'summary' with value 'brute force is viable', then complete the task. Only note and complete_task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 3,
        "max_invalid_actions": 4,
        "max_wall_seconds": 600
      }
    },
    {
      "id": "kimi-missing-tool-recovery",
      "title": "[kimi] Ask for an unregistered tool, then recover",
      "mode": "bug-bounty",
      "scope_includes": [
        "example.com"
      ],
      "live": {
        "base_url": "https://api.moonshot.ai/v1",
        "model": "moonshot/kimi-k3@v1",
        "secret_env": "MOONSHOT_API_KEY",
        "verify_tls": true,
        "cost_input_per_m": 0.0,
        "cost_output_per_m": 0.0,
        "timeout_seconds": 300.0
      },
      "tasks": [
        {
          "id": "main",
          "title": "Probe. Request the tool 'dnsx_lookup' once — it is not registered. Do not try other tools afterwards: use note with key 'retry' and value 'resolve manually instead', then complete the task.",
          "risk_class": "r1"
        }
      ],
      "expectations": {
        "expect_solve": true,
        "min_tasks_done": 1,
        "max_invalid_actions": 3,
        "max_wall_seconds": 300
      }
    },
